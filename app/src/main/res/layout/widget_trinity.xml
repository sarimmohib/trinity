<?xml version="1.0" encoding="utf-8"?>
<!-- Only RemoteViews-safe views are used here: LinearLayout and TextView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1EDE4"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/row_unread"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label_unread"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_unread"
            android:textColor="#FF17160F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/count_unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero"
            android:textColor="#FF2E7A61"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_missed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label_missed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_missed"
            android:textColor="#FF17160F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/count_missed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero"
            android:textColor="#FF2E7A61"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_held"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label_held"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_held"
            android:textColor="#FF17160F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/count_held"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero"
            android:textColor="#FF2E7A61"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
